# Copy to keystore.properties (gitignored). Only needed for signed release builds
# (./gradlew bundleRelease); debug builds don't use it.
#
# storeFile is resolved relative to the project root; an absolute path is fine too.
# Keeping the keystore outside the project makes accidental sharing less likely.
storeFile=/Users/<you>/keys/chess-review-upload.jks
storePassword=<keystore password>
keyAlias=upload
keyPassword=<key password>
