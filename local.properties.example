# Copy to local.properties (gitignored) and set the path to your Android SDK.
# Alternatively, skip this file and export ANDROID_HOME.
#   macOS (Android Studio default): /Users/<you>/Library/Android/sdk
#   Linux (Android Studio default): /home/<you>/Android/Sdk
#   Windows: C\:\\Users\\<you>\\AppData\\Local\\Android\\Sdk
sdk.dir=/Users/<you>/Library/Android/sdk
